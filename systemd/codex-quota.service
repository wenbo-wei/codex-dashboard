[Unit]
Description=Codex Dashboard quota state publisher
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I %h/.local/bin/codex-quota --headless
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077

[Install]
WantedBy=graphical-session.target
