#!/usr/bin/python3
"""Build truthful local data for the Codex GNOME dashboard.

Quota values come from codex-quota's live account snapshot. Historical token
totals come from Codex's official account usage endpoint; while its current-day
bucket is pending, Today is estimated from local token counters and clearly
marked as approximate. Recent task overviews come only from the current Codex
thread index.
"""

from __future__ import annotations

import calendar
from collections import defaultdict
import datetime as dt
from enum import StrEnum
import json
import math
import os
from pathlib import Path
import re
import sqlite3
import sys
import tempfile
import time
from typing import Any
import unicodedata


