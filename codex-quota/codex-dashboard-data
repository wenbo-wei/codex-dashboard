class Availability(StrEnum):
    READY = "ready"
    STALE = "stale"
    UNAVAILABLE = "unavailable"


def normalize_availability(value: Any) -> Availability:
    try:
        return Availability(value)
    except (TypeError, ValueError):
        return Availability.UNAVAILABLE


def quota_availability(
    quota: dict[str, Any],
    explicit: Any = None,
    *,
    now_seconds: float | None = None,
) -> Availability:
    explicit_state: Availability | None = None
    if explicit is not None:
        explicit_state = normalize_availability(explicit)
        if explicit_state is Availability.UNAVAILABLE:
            return Availability.UNAVAILABLE

    limits = quota.get("limits")
    if not isinstance(limits, list) or not limits:
        return Availability.UNAVAILABLE
    if explicit_state is Availability.STALE or quota.get("_stale") is True:
        return Availability.STALE

    updated_at = quota.get("updated_at_seconds")
    if (
        not isinstance(updated_at, bool)
        and isinstance(updated_at, (int, float))
        and math.isfinite(float(updated_at))
    ):
        now = time.time() if now_seconds is None else float(now_seconds)
        if math.isfinite(now) and now - float(updated_at) >= (
            QUOTA_STALE_AFTER_SECONDS
        ):
            return Availability.STALE
    return Availability.READY


def availability_payload(
    *,
    quota: Any,
    usage: Any,
    tasks: Any,
) -> dict[str, str]:
    return {
        "quota": normalize_availability(quota).value,
        "usage": normalize_availability(usage).value,
        "tasks": normalize_availability(tasks).value,
    }



def _codex_home() -> Path:
    return Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))


def _runtime_dir() -> Path:
    return Path(
        os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    )


def _local_activity_state_path() -> Path:
    return _runtime_dir() / "codex-dashboard-today.json"


def _quota_state() -> dict[str, Any]:
    path = _runtime_dir() / "codex-quota.json"
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return {"limits": [], "_source": "missing", "_stale": True}
    return payload if isinstance(payload, dict) else {
        "limits": [],
        "_source": "invalid",
        "_stale": True,
    }


def _latest_state_db(codex_home: Path) -> Path | None:
    candidates: list[tuple[int, Path]] = []
    for path in codex_home.glob("state_*.sqlite"):
        try:
            candidates.append((path.stat().st_mtime_ns, path))
        except OSError:
            continue
    return max(candidates, default=(0, None))[1]


def _connect_read_only(path: Path) -> sqlite3.Connection:
    return sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=0.5)


def _thread_index_path(codex_home: Path) -> Path:
    state_db = _latest_state_db(codex_home)
    if state_db is None or not state_db.is_file():
        raise FileNotFoundError("Codex thread index is unavailable")
    return state_db


def _thread_columns(connection: sqlite3.Connection) -> set[str]:
    return {
        str(row[1])
        for row in connection.execute("PRAGMA table_info(threads)")
        if len(row) > 1
    }


def _nonnegative_token_count(value: Any) -> int | None:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    try:
        numeric = float(value)
    except OverflowError:
        return None
    if not math.isfinite(numeric) or value < 0:
        return None
    return int(value)


def _load_local_activity_state(
    path: Path,
    codex_home: Path,
) -> dict[str, Any]:
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return {}
    if (
        not isinstance(payload, dict)
        or payload.get("version") != LOCAL_ACTIVITY_STATE_VERSION
        or payload.get("codex_home") != str(codex_home.resolve())
    ):
        return {}
    return payload


def _write_local_activity_state(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary_path: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=path.parent,
            prefix=".codex-dashboard-today-",
            suffix=".tmp",
            delete=False,
        ) as temporary:
            temporary_path = Path(temporary.name)
            os.fchmod(temporary.fileno(), 0o600)
            json.dump(
                payload,
                temporary,
                ensure_ascii=False,
                separators=(",", ":"),
            )
            temporary.flush()
            os.fsync(temporary.fileno())
        os.replace(temporary_path, path)
        temporary_path = None
    finally:
        if temporary_path is not None:
            try:
                temporary_path.unlink()
            except FileNotFoundError:
                pass


def _current_day_activity_state(
    path: Path,
    codex_home: Path,
    now: dt.datetime,
) -> dict[str, Any]:
    state = _load_local_activity_state(path, codex_home)
    if state.get("date") != now.date().isoformat():
        return {}
    return state


def _monotonic_today_estimate(
    value: int,
    path: Path,
    codex_home: Path,
    now: dt.datetime,
) -> int:
    state = _current_day_activity_state(path, codex_home, now)
    if not state:
        raise ValueError("Today estimate state is unavailable")
    previous = _nonnegative_token_count(state.get("last_estimate"))
    monotonic_value = max(value, previous or 0)
    if previous is not None and monotonic_value == previous:
        return previous
    state["last_estimate"] = monotonic_value
    try:
        _write_local_activity_state(path, state)
    except OSError:
        if previous is not None:
            return previous
        raise
    return monotonic_value


def _persisted_today_floor(
    path: Path,
    codex_home: Path,
    now: dt.datetime,
) -> int | None:
    state = _current_day_activity_state(path, codex_home, now)
    return _nonnegative_token_count(state.get("last_estimate"))


def _recent_day_totals(
    value: Any,
    cutoff: dt.date,
    before: dt.date,
) -> dict[str, int]:
    if not isinstance(value, dict):
        return {}
    totals: dict[str, int] = {}
    for day_value, tokens_value in value.items():
        if not isinstance(day_value, str):
            continue
        try:
            day = dt.date.fromisoformat(day_value)
        except ValueError:
            continue
        tokens = _nonnegative_token_count(tokens_value)
        if cutoff <= day < before and tokens is not None:
            totals[day_value] = tokens
    return totals


class LocalThreadTokenActivity:
    """Maintain monotonic local-day totals from numeric thread counters."""

    def __init__(
        self,
        codex_home: Path,
        state_path: Path,
        now: dt.datetime | None = None,
    ) -> None:
        self._codex_home = codex_home
        self._state_path = state_path
        self._now = now

    def build(self) -> dict[str, int]:
        now = self._now or dt.datetime.now().astimezone()
        if now.tzinfo is None:
            now = now.astimezone()
        timezone = now.tzinfo
        if timezone is None:
            raise ValueError("Local timezone is unavailable")

        state_db = _thread_index_path(self._codex_home)
        with _connect_read_only(state_db) as connection:
            columns = _thread_columns(connection)
            if "tokens_used" not in columns:
                raise sqlite3.DatabaseError(
                    "Codex thread token counters are unavailable"
                )
            time_column = next(
                (
                    column
                    for column in ("created_at", "created_at_ms")
                    if column in columns
                ),
                None,
            )
            if time_column is None:
                raise sqlite3.DatabaseError(
                    "Codex thread start times are unavailable"
                )

            rows = connection.execute(
                f"""
                SELECT {time_column}, tokens_used
                FROM threads
                """
            ).fetchall()

        today = now.date()
        cutoff = today - dt.timedelta(days=LOCAL_ESTIMATE_LOOKBACK_DAYS)
        grouped_totals: defaultdict[str, int] = defaultdict(int)
        account_total = 0
        valid_counter_rows = 0
        account_snapshot_complete = bool(rows)
        day_grouping_complete = bool(rows)
        for created_at, tokens_used in rows:
            tokens = _nonnegative_token_count(tokens_used)
            if tokens is None:
                account_snapshot_complete = False
                day_grouping_complete = False
                continue
            valid_counter_rows += 1
            account_total += tokens
            if (
                isinstance(created_at, bool)
                or not isinstance(created_at, (int, float))
                or not math.isfinite(float(created_at))
            ):
                day_grouping_complete = False
                continue
            timestamp = float(created_at)
            if time_column.endswith("_ms"):
                timestamp /= 1_000
            try:
                day = dt.datetime.fromtimestamp(
                    timestamp,
                    tz=timezone,
                ).date()
            except (OverflowError, OSError, ValueError):
                day_grouping_complete = False
                continue
            if cutoff <= day <= today:
                grouped_totals[day.isoformat()] += tokens
        if valid_counter_rows == 0:
            account_snapshot_complete = False
            day_grouping_complete = False

        offset = now.utcoffset()
        offset_seconds = int(offset.total_seconds()) if offset is not None else 0
        state = _load_local_activity_state(
            self._state_path,
            self._codex_home,
        )
        previous_total = _nonnegative_token_count(
            state.get("total_snapshot")
        )
        previous_today = _nonnegative_token_count(
            state.get("today_tokens")
        )
        try:
            previous_date = dt.date.fromisoformat(state.get("date", ""))
        except (TypeError, ValueError):
            previous_date = None

        baseline_is_trusted = (
            previous_date in {today, today - dt.timedelta(days=1)}
            and state.get("total_snapshot_complete") is True
            and previous_total is not None
        )
        today_snapshot_is_trusted = (
            baseline_is_trusted and previous_today is not None
        )
        if not account_snapshot_complete and not baseline_is_trusted:
            raise ValueError("No complete local token snapshot is available")

        completed_days = _recent_day_totals(
            state.get("completed_days") if baseline_is_trusted else None,
            cutoff,
            today,
        )
        if baseline_is_trusted and previous_date == today:
            if not account_snapshot_complete:
                if previous_today is None:
                    raise ValueError("Today local token activity is unavailable")
                totals = dict(completed_days)
                totals[today.isoformat()] = previous_today
                return totals

            if previous_today is not None:
                growth_estimate = previous_today + max(
                    0,
                    account_total - previous_total,
                )
                today_tokens = max(
                    growth_estimate,
                    grouped_totals.get(today.isoformat(), 0)
                    if day_grouping_complete
                    else 0,
                )
                total_snapshot = account_total
            elif day_grouping_complete:
                completed_days = {
                    day: tokens
                    for day, tokens in grouped_totals.items()
                    if day != today.isoformat()
                }
                today_tokens = max(
                    grouped_totals.get(today.isoformat(), 0),
                    max(0, account_total - previous_total),
                )
                total_snapshot = account_total
            else:
                growth = max(0, account_total - previous_total)
                today_tokens = growth if growth > 0 else None
                total_snapshot = account_total
        elif (
            today_snapshot_is_trusted
            and previous_date == today - dt.timedelta(days=1)
        ):
            if not account_snapshot_complete:
                raise ValueError("Today local token activity is unavailable")
            completed_days[previous_date.isoformat()] = previous_today
            today_tokens = max(
                grouped_totals.get(today.isoformat(), 0)
                if day_grouping_complete
                else 0,
                max(0, account_total - previous_total),
            )
            total_snapshot = account_total
        else:
            if day_grouping_complete:
                completed_days = {
                    day: tokens
                    for day, tokens in grouped_totals.items()
                    if day != today.isoformat()
                }
                today_tokens = grouped_totals.get(today.isoformat(), 0)
            else:
                completed_days = {}
                today_tokens = None
            total_snapshot = account_total

        payload = {
            "version": LOCAL_ACTIVITY_STATE_VERSION,
            "codex_home": str(self._codex_home.resolve()),
            "timezone_offset_seconds": offset_seconds,
            "date": today.isoformat(),
            "generated_at": now.isoformat(),
            "total_snapshot": total_snapshot,
            "total_snapshot_complete": True,
            "today_tokens": today_tokens,
            "completed_days": completed_days,
        }
        if previous_date == today and today_tokens is not None:
            last_estimate = _nonnegative_token_count(
                state.get("last_estimate")
            )
            if last_estimate is not None:
                payload["last_estimate"] = last_estimate
        _write_local_activity_state(self._state_path, payload)
        if today_tokens is None:
            raise ValueError("Today local token activity is unavailable")

        totals = dict(completed_days)
        totals[today.isoformat()] = today_tokens
        return totals


def _shift_month(value: dt.date, offset: int) -> dt.date:
    month_index = value.year * 12 + value.month - 1 + offset
    year, month = divmod(month_index, 12)
    return dt.date(year, month + 1, 1)


def _calendar_months(
    totals: dict[str, int],
    today: dt.date,
) -> list[dict[str, Any]]:
    months: list[dict[str, Any]] = []
    first_month = _shift_month(today, -(CALENDAR_MONTH_COUNT - 1))
    for offset in range(CALENDAR_MONTH_COUNT):
        month_start = _shift_month(first_month, offset)
        days_in_month = calendar.monthrange(
            month_start.year,
            month_start.month,
        )[1]
        last_day = today.day if (
            month_start.year == today.year
            and month_start.month == today.month
        ) else days_in_month

        def tokens_for_day(day: int) -> int | None:
            date = dt.date(month_start.year, month_start.month, day)
            key = date.isoformat()
            if key in totals:
                return totals[key]
            return None if date == today else 0

        months.append({
            "key": month_start.strftime("%Y-%m"),
            "label": calendar.month_name[month_start.month],
            "year": month_start.year,
            "month": month_start.month,
            "days": [
                {
                    "day": day,
                    "tokens": tokens_for_day(day),
                }
                for day in range(1, last_day + 1)
            ],
        })
    return months


def _today_estimate_payload(
    value: int | None = None,
    source: str | None = None,
    calibration_date: str | None = None,
) -> dict[str, Any]:
    return {
        "today_estimate": value,
        "today_is_estimate": value is not None,
        "today_estimate_source": source,
        "today_estimate_calibration_date": calibration_date,
    }


def _token_usage() -> dict[str, Any]:
    now = dt.datetime.now().astimezone()
    payload = _read_official_usage()
    usage = OfficialTokenActivity(now).build(payload)
    usage.update(_today_estimate_payload())
    local_activity = LocalThreadTokenActivity(
        _codex_home(),
        _local_activity_state_path(),
        now,
    )
    try:
        local_totals = local_activity.build()
    except (OSError, sqlite3.Error, ValueError, OverflowError):
        # Estimation is optional; never hide known official history if local
        # counters or their read-only index are temporarily unavailable.
        if not usage["current_day_available"]:
            floor = _persisted_today_floor(
                _local_activity_state_path(),
                _codex_home(),
                now,
            )
            if floor is not None:
                usage.update(_today_estimate_payload(
                    floor,
                    "local_thread_tokens_persisted_floor",
                ))
        return usage
    if usage["current_day_available"]:
        return usage

    estimate = _calibrated_today_estimate(
        local_totals,
        usage["days"],
        now.date(),
    )
    if estimate is None:
        return usage
    value, source, calibration_date = estimate
    try:
        value = _monotonic_today_estimate(
            value,
            _local_activity_state_path(),
            _codex_home(),
            now,
        )
    except (OSError, ValueError):
        return usage
    usage.update(_today_estimate_payload(value, source, calibration_date))
    return usage


def _read_official_usage(
    timeout_seconds: float = OFFICIAL_USAGE_TIMEOUT_SECONDS,
    *,
    query=query_codex_app_server,
) -> dict[str, Any]:
    return query(
        CODEX_BIN,
        "account/usage/read",
        None,
        timeout_seconds=timeout_seconds,
        max_line_bytes=MAX_PROTOCOL_LINE_BYTES,
        cancel_event=None,
    )


class OfficialTokenActivity:
    """Render account token activity returned by the Codex service."""

    def __init__(self, now: dt.datetime | None = None) -> None:
        self._now = now

    def build(self, payload: dict[str, Any]) -> dict[str, Any]:
        summary = payload.get("summary")
        buckets = payload.get("dailyUsageBuckets")
        if not isinstance(summary, dict) or not isinstance(buckets, list):
            raise ValueError("Official token activity is unavailable")

        now = self._now or dt.datetime.now().astimezone()
        if now.tzinfo is None:
            now = now.astimezone()
        today = now.date()
        totals: defaultdict[str, int] = defaultdict(int)
        for bucket in buckets:
            if not isinstance(bucket, dict):
                continue
            day = bucket.get("startDate")
            tokens = bucket.get("tokens")
            if (
                not isinstance(day, str)
                or isinstance(tokens, bool)
                or not isinstance(tokens, (int, float))
                or not math.isfinite(float(tokens))
                or tokens < 0
            ):
                continue
            try:
                parsed_day = dt.date.fromisoformat(day)
            except ValueError:
                continue
            if parsed_day <= today:
                totals[parsed_day.isoformat()] += int(tokens)

        current_day_available = today.isoformat() in totals
        daily = []
        for offset in range(HISTORY_DAYS - 1, -1, -1):
            day = today - dt.timedelta(days=offset)
            key = day.isoformat()
            daily.append({
                "date": key,
                "tokens": (
                    totals[key]
                    if key in totals
                    else None
                    if day == today
                    else 0
                ),
            })
        latest_bucket_date = max(totals, default=None)

        def known_total(items: list[dict[str, Any]]) -> int:
            return sum(
                item["tokens"]
                for item in items
                if isinstance(item.get("tokens"), int)
            )

        def summary_tokens(key: str) -> int | None:
            value = summary.get(key)
            if (
                isinstance(value, bool)
                or not isinstance(value, (int, float))
                or not math.isfinite(float(value))
                or value < 0
            ):
                return None
            return int(value)

        return {
            "today": daily[-1]["tokens"],
            "seven_days": known_total(daily[-7:]),
            "ninety_days": known_total(daily[-90:]),
            "lifetime": summary_tokens("lifetimeTokens"),
            "peak_daily": summary_tokens("peakDailyTokens"),
            "latest_bucket_date": latest_bucket_date,
            "current_day_available": current_day_available,
            "days": daily,
            "calendar_months": _calendar_months(totals, today),
            "source": "official_account_usage",
            "includes_cached_input": False,
        }


def _valid_calibration_factor(value: float) -> bool:
    return (
        math.isfinite(value)
        and MIN_CALIBRATION_FACTOR <= value <= MAX_CALIBRATION_FACTOR
    )


def _calibrated_today_estimate(
    local_totals: dict[str, int],
    official_days: list[dict[str, Any]],
    today: dt.date,
) -> tuple[int, str, str | None] | None:
    if not isinstance(local_totals, dict):
        return None
    today_key = today.isoformat()
    local_today = _nonnegative_token_count(local_totals.get(today_key))
    if local_today is None:
        return None
    if local_today == 0:
        return 0, "local_thread_tokens", None

    cutoff = today - dt.timedelta(days=LOCAL_ESTIMATE_LOOKBACK_DAYS)
    samples: list[tuple[dt.date, int, int]] = []
    for item in official_days:
        if not isinstance(item, dict):
            continue
        day_value = item.get("date")
        official_tokens = _nonnegative_token_count(item.get("tokens"))
        if not isinstance(day_value, str) or not official_tokens:
            continue
        try:
            day = dt.date.fromisoformat(day_value)
        except ValueError:
            continue
        local_tokens = _nonnegative_token_count(local_totals.get(day_value))
        if (
            cutoff <= day < today
            and local_tokens is not None
            and local_tokens > 0
        ):
            samples.append((day, official_tokens, local_tokens))

    if samples:
        latest_day, official_tokens, local_tokens = max(samples)
        latest_factor = official_tokens / local_tokens
        if _valid_calibration_factor(latest_factor):
            return (
                int(math.floor(local_today * latest_factor + 0.5)),
                "local_thread_tokens_recent_calibration",
                latest_day.isoformat(),
            )

    return local_today, "local_thread_tokens_uncalibrated", None


def _display_width(value: str) -> int:
    return sum(
        0
        if unicodedata.combining(character)
        else 2
        if unicodedata.east_asian_width(character) in {"W", "F"}
        else 1
        for character in value
    )


def _ascii_bounded_phrase(
    value: Any,
    columns: int = TASK_OVERVIEW_COLUMNS,
) -> str:
    """Accept one complete ASCII phrase that fits the display budget."""

    if not isinstance(value, str):
        return ""
    text = " ".join(value.split()).strip()
    if (
        not text
        or not text.isascii()
        or not text.isprintable()
        or not any(character.isalpha() for character in text)
        or "..." in text
        or _display_width(text) > columns
    ):
        return ""
    return text


def _strip_task_command_prefix(value: Any) -> str:
    if not isinstance(value, str):
        return ""
    return TASK_COMMAND_PREFIX.sub("", value.lstrip())


def _strip_injected_prefixes(value: str) -> str:
    text = value.lstrip()
    if INJECTED_MARKDOWN_ONLY.match(text):
        return ""

    agents_header = AGENTS_HEADER.match(text)
    if agents_header:
        text = text[agents_header.end():]

    removed_block = False
    while match := INJECTED_XML_BLOCK.match(text):
        removed_block = True
        text = text[match.end():].lstrip()

    if (agents_header and not removed_block) or INJECTED_XML_OPEN.match(text):
        return ""
    if text.casefold().startswith(INJECTED_SUMMARY_PREFIXES):
        return ""
    return text


def _task_reference(value: Any) -> str:
    """Normalize task text without shortening it for topic comparison."""

    if not isinstance(value, str):
        return ""
    text = unicodedata.normalize("NFKC", value)
    text = _strip_task_command_prefix(text)
    text = _strip_injected_prefixes(text)
    text = IMAGE_PLACEHOLDER.sub(" ", text)
    text = MARKDOWN_LINK.sub(r"\1", text)
    text = LEADING_MARKDOWN.sub("", text)
    text = " ".join(text.split())
    return LEADING_GREETING.sub("", text).strip()


def _is_meaningful_user_message(value: Any) -> bool:
    text = _task_reference(value)
    if not text:
        return False
    compact = re.sub(r"[\W_]+", "", text, flags=re.UNICODE)
    return bool(compact) and GENERIC_USER_REPLY.fullmatch(compact) is None


def _topic_tokens(value: Any) -> set[str]:
    text = _task_reference(value)
    if len(text) > MAX_TASK_REFERENCE_CHARACTERS:
        text = text[:MAX_TASK_REFERENCE_CHARACTERS]
    text = text.casefold()
    tokens = {
        word
        for word in LATIN_TOPIC_WORD.findall(text)
        if word not in LATIN_TOPIC_STOP_WORDS
    }
    for run in CJK_TOPIC_RUN.findall(text):
        if len(run) == 1:
            tokens.add(run)
            continue
        tokens.update(
            run[index:index + 2]
            for index in range(len(run) - 1)
        )
    return tokens


def _intent_is_negated(reference: str, start: int) -> bool:
    prefix = reference[max(0, start - 48):start]
    boundaries = list(INTENT_SCOPE_BOUNDARY.finditer(prefix))
    if boundaries:
        prefix = prefix[boundaries[-1].end():]
    if FALSE_NEGATION.search(prefix):
        return False
    return ACTION_NEGATION.search(prefix) is not None


def _english_action(values: Iterable[Any]) -> str:
    """Choose the earliest non-negated action from each source in order."""

    for value in values:
        reference = _task_reference(value)[:MAX_TASK_REFERENCE_CHARACTERS]
        ranked: list[tuple[tuple[int, int], str]] = []
        for priority, (pattern, result) in enumerate(ENGLISH_ACTION_RULES):
            for match in pattern.finditer(reference):
                if _intent_is_negated(reference, match.start()):
                    continue
                ranked.append(((match.start(), priority), result))
        if ranked:
            return min(ranked, key=lambda item: item[0])[1]
    return ""


def _conversation_subject(
    initial_reference: Any,
    conversation_parts: Iterable[Any],
    core: Any,
) -> str:
    """Anchor a recognized subject, then use all later turns to fill a gap."""

    initial = _task_reference(initial_reference)
    for pattern, result in ENGLISH_SUBJECT_RULES:
        if initial and any(
            not _intent_is_negated(initial, match.start())
            for match in pattern.finditer(initial)
        ):
            return result

    for value in (*conversation_parts, core):
        reference = _task_reference(value)[:MAX_TASK_REFERENCE_CHARACTERS]
        for pattern, result in ENGLISH_SUBJECT_RULES:
            if any(
                not _intent_is_negated(reference, match.start())
                for match in pattern.finditer(reference)
            ):
                return result
    return ""


def _technical_subject(
    values: Iterable[Any],
    columns: int,
    *,
    allow_negated: bool = False,
) -> str:
    """Choose one compact ASCII product or identifier as a subject."""

    ranked: list[tuple[tuple[int, int, int, int], str]] = []
    seen: set[str] = set()
    for source_order, value in enumerate(values):
        reference = _task_reference(value)[:MAX_TASK_REFERENCE_CHARACTERS]
        for term_order, match in enumerate(TECHNICAL_TERM.finditer(reference)):
            term = match.group(0).strip("._-")
            folded = term.casefold()
            adjacent = reference[max(0, match.start() - 3):match.start()]
            boundary = (
                reference[match.start() - 1:match.start()]
                + reference[match.end():match.end() + 1]
            )
            if (
                folded in seen
                or folded in TECHNICAL_TERM_STOP_WORDS
                or len(term) < 2
                or len(term) > 24
                or (
                    not allow_negated
                    and _intent_is_negated(reference, match.start())
                )
                or "://" in adjacent
                or any(character in "./\\@" for character in boundary)
                or SENSITIVE_TECHNICAL_TERM.search(term)
                or folded.startswith(
                    (
                        "aiza",
                        "akia",
                        "asia",
                        "eyj",
                        "ghp_",
                        "github_pat_",
                        "glpat-",
                        "pypi-",
                        "pk_live",
                        "pk_test",
                        "rk_live",
                        "rk_test",
                        "sk-",
                        "sk_live",
                        "sk_test",
                        "xox",
                    )
                )
                or not _ascii_bounded_phrase(term, columns)
            ):
                continue
            seen.add(folded)
            distinctive = (
                any(character.isdigit() for character in term)
                or any(character in ".+#@_-" for character in term)
                or term.isupper()
                or any(character.isupper() for character in term[1:])
            )
            if not distinctive:
                continue
            ranked.append((
                (
                    -source_order,
                    -term_order,
                    len(term),
                    0,
                ),
                term,
            ))
    return max(ranked, default=((0, 0, 0, 0), ""), key=lambda item: item[0])[1]


def _english_task_overview(
    core: Any,
    initial_reference: Any,
    conversation_parts: Iterable[Any],
) -> str:
    """Build one stable English action-and-subject task overview."""

    parts = [
        reference
        for value in conversation_parts
        if (reference := _task_reference(value))
    ]
    initial = _task_reference(initial_reference)
    semantic_core = _task_reference(core)

    action = (
        _english_action((initial,))
        or _english_action(parts)
        or _english_action((semantic_core,))
        or "Handle"
    )
    subject_sources = [initial, *parts]
    subject = _conversation_subject(initial, parts, semantic_core)
    subject_columns = TASK_OVERVIEW_COLUMNS - len(action) - 1
    initial_technical = _technical_subject((initial,), subject_columns)
    revision_technical = _technical_subject(
        (part for part in parts if SUBJECT_REVISION.search(part)),
        subject_columns,
    )
    if subject and revision_technical.isupper():
        revision_technical = ""
    technical_subject = initial_technical or revision_technical
    if not subject and not technical_subject:
        technical_subject = _technical_subject(
            subject_sources,
            subject_columns,
        )
    if (
        not subject
        and not technical_subject
        and any(
            PRONOUN_CONTINUATION.search(source)
            for source in subject_sources
        )
    ):
        technical_subject = _technical_subject(
            subject_sources,
            subject_columns,
            allow_negated=True,
        )
    if technical_subject and subject not in PREFERRED_CLASSIFIED_SUBJECTS:
        subject = technical_subject
    if not subject:
        subject = "requested task"

    overview = _ascii_bounded_phrase(f"{action} {subject}")
    return overview or "Handle requested task"


def _english_explicit_name(value: Any) -> str:
    """Accept only a concise English name with task-level semantics."""

    candidate = _ascii_bounded_phrase(_task_reference(value))
    if (
        not candidate
        or INCOMPLETE_ENGLISH_END.search(candidate)
        or UNSAFE_EXPLICIT_NAME.search(candidate)
    ):
        return ""
    action = _english_action((candidate,))
    if not action:
        return ""
    first_word = candidate.split(maxsplit=1)[0]
    if _english_action((first_word,)) != action or len(candidate.split()) < 2:
        return ""
    return candidate


def _assistant_clauses(value: Any) -> list[str]:
    if not isinstance(value, str):
        return []
    text = value.split("<oai-mem-citation", 1)[0]
    clauses: list[str] = []
    inside_fence = False
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if line.startswith("```"):
            inside_fence = not inside_fence
            continue
        if inside_fence or not line:
            continue
        if line.startswith("#"):
            continue
        line = MARKDOWN_LINK.sub(r"\1", line)
        line = MARKDOWN_PREFIX.sub("", line)
        line = line.replace("`", "").replace("**", "").replace("__", "")
        for raw_clause in CLAUSE_BREAK.split(line):
            clause = raw_clause.strip(
                " \t\r\n\"'\u201c\u201d\u2018\u2019()[]{}"
            )
            clause = ASSISTANT_SELF_PREFIX.sub("", clause)
            clause = CLAUSE_CONNECTOR.sub("", clause)
            clause = clause.strip(
                " \t\r\n\"'\u201c\u201d\u2018\u2019()[]{}"
            )
            if not clause:
                continue
            compact = re.sub(
                r"[\W_]+",
                "",
                clause,
                flags=re.UNICODE,
            ).casefold()
            if (
                _display_width(clause) < 6
                or compact in GENERIC_ASSISTANT_CLAUSES
                or GENERIC_ASSISTANT_STATUS.fullmatch(compact)
                or ASSISTANT_PROGRESS_PREFIX.match(clause)
                or WORKFLOW_RESULT.fullmatch(compact)
            ):
                continue
            clauses.append(clause)
    return clauses


def _is_plan_message(value: Any) -> bool:
    if not isinstance(value, str):
        return False
    first_line = next(
        (
            MARKDOWN_PREFIX.sub("", line.strip())
            for line in value.splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        ),
        "",
    )
    return ASSISTANT_PLAN_PREFIX.match(first_line) is not None


def _assistant_semantic_core(
    candidates: list[str],
    reference_tokens: set[str],
) -> str:
    for message in candidates:
        ranked: list[tuple[tuple[int, int, int, int], str]] = []
        for order, clause in enumerate(_assistant_clauses(message)):
            clause_tokens = _topic_tokens(clause)
            shared = reference_tokens & clause_tokens
            overlap_weight = sum(len(token) for token in shared)
            density = (
                overlap_weight * 100 // max(
                    1,
                    sum(len(token) for token in clause_tokens),
                )
            )
            ranked.append((
                (
                    overlap_weight,
                    density,
                    -order,
                    _display_width(clause),
                ),
                clause,
            ))
        if not ranked:
            continue
        score, clause = max(ranked, key=lambda item: item[0])
        if reference_tokens and score[0] == 0:
            continue
        return clause
    return ""


def _iso_timestamp(value: Any) -> str:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return ""
    numeric = float(value)
    if not math.isfinite(numeric) or numeric <= 0:
        return ""
    if numeric >= 10_000_000_000:
        numeric /= 1_000
    try:
        moment = dt.datetime.fromtimestamp(numeric, tz=dt.timezone.utc)
    except (OverflowError, OSError, ValueError):
        return ""
    return moment.isoformat().replace("+00:00", "Z")


def _reversed_snapshot_lines(stream: BinaryIO) -> Iterator[bytes]:
    """Yield complete JSONL lines from one fixed file snapshot, newest first."""

    snapshot_size = os.fstat(stream.fileno()).st_size
    if snapshot_size <= 0:
        return
    with mmap.mmap(
        stream.fileno(),
        length=snapshot_size,
        access=mmap.ACCESS_READ,
    ) as content:
        end = snapshot_size
        if content[end - 1:end] != b"\n":
            end = content.rfind(b"\n", 0, end)
            if end < 0:
                return
        while end > 0 and content[end - 1:end] == b"\n":
            end -= 1
        floor = max(0, end - MAX_TRANSCRIPT_SCAN_BYTES)
        while end > floor:
            start = content.rfind(b"\n", floor, end)
            if start < 0 and floor > 0:
                return
            line_start = start + 1
            if end - line_start <= MAX_TRANSCRIPT_LINE_BYTES:
                yield bytes(content[line_start:end])
            end = start


class ConversationOverviewResolver:
    """Resolve a short overview from an existing local Codex conversation."""

    def __init__(self, codex_home: Path) -> None:
        self._sessions_dir = codex_home / "sessions"

    def _rollout_path(self, value: Any) -> Path | None:
        if not isinstance(value, str) or not value.strip():
            return None
        try:
            sessions_dir = self._sessions_dir.resolve(strict=True)
            rollout_path = Path(value).resolve(strict=True)
        except (OSError, RuntimeError):
            return None
        if (
            rollout_path.suffix != ".jsonl"
            or sessions_dir not in rollout_path.parents
            or not rollout_path.is_file()
        ):
            return None
        return rollout_path

    @staticmethod
    def _matches_thread(stream: BinaryIO, thread_id: Any) -> bool:
        stream.seek(0)
        first_line = stream.readline(MAX_TRANSCRIPT_LINE_BYTES + 1)
        if (
            not first_line.endswith(b"\n")
            or len(first_line) > MAX_TRANSCRIPT_LINE_BYTES
        ):
            return False
        try:
            record = json.loads(first_line)
        except (UnicodeDecodeError, json.JSONDecodeError):
            return False
        if not isinstance(record, dict):
            return False
        payload = record.get("payload")
        return (
            record.get("type") == "session_meta"
            and isinstance(payload, dict)
            and payload.get("id") == str(thread_id)
        )

    def resolve(
        self,
        thread_id: Any,
        rollout_value: Any,
        initial_reference: Any,
    ) -> str:
        rollout_path = self._rollout_path(rollout_value)
        if rollout_path is None:
            return ""

        latest_completion = ""
        latest_final = ""
        opening_commentary = ""
        latest_user_found = False
        conversation_parts: list[str] = []
        reference_tokens = _topic_tokens(initial_reference)
        try:
            with rollout_path.open("rb") as stream:
                if not self._matches_thread(stream, thread_id):
                    return ""
                complete_scan = (
                    os.fstat(stream.fileno()).st_size
                    <= MAX_TRANSCRIPT_SCAN_BYTES
                )
                for raw_line in _reversed_snapshot_lines(stream):
                    if (
                        b'"event_msg"' not in raw_line
                        or not any(
                            marker in raw_line
                            for marker in (
                                b'"task_complete"',
                                b'"agent_message"',
                                b'"user_message"',
                            )
                        )
                    ):
                        continue
                    try:
                        record = json.loads(raw_line)
                    except (UnicodeDecodeError, json.JSONDecodeError):
                        continue
                    if (
                        not isinstance(record, dict)
                        or record.get("type") != "event_msg"
                    ):
                        continue
                    payload = record.get("payload")
                    if not isinstance(payload, dict):
                        continue

                    payload_type = payload.get("type")
                    if (
                        not latest_user_found
                        and payload_type == "task_complete"
                    ):
                        message = payload.get("last_agent_message")
                        if isinstance(message, str) and not latest_completion:
                            latest_completion = message
                        continue
                    if payload_type == "agent_message":
                        message = payload.get("message")
                        phase = payload.get("phase")
                        if isinstance(message, str):
                            if (
                                not latest_user_found
                                and phase == "final_answer"
                                and not latest_final
                            ):
                                latest_final = message
                            elif (
                                complete_scan
                                and phase == "commentary"
                                and _is_plan_message(message)
                            ):
                                opening_commentary = message
                        continue
                    if (
                        payload_type == "user_message"
                        and _is_meaningful_user_message(
                            payload.get("message")
                        )
                    ):
                        message_reference = _task_reference(
                            payload.get("message")
                        )
                        latest_user_found = True
                        reference_tokens.update(_topic_tokens(message_reference))
                        conversation_parts.append(
                            message_reference[:MAX_TASK_REFERENCE_CHARACTERS]
                        )
        except (OSError, ValueError):
            return ""
        if not latest_user_found:
            return ""

        candidates = []
        for message in (
            opening_commentary,
            latest_completion,
            latest_final,
        ):
            if message and message not in candidates:
                candidates.append(message)
        conversation_parts.reverse()
        semantic_core = _assistant_semantic_core(
            candidates,
            reference_tokens,
        )
        return _english_task_overview(
            semantic_core,
            initial_reference,
            conversation_parts,
        )


class RecentTaskReader:
    """Read one bounded, conversation-aware overview per recent root thread."""

    def __init__(self, codex_home: Path) -> None:
        self._codex_home = codex_home
        self._conversation_overviews = ConversationOverviewResolver(codex_home)

    def read(self) -> list[dict[str, Any]]:
        state_db = _thread_index_path(self._codex_home)
        with _connect_read_only(state_db) as connection:
            columns = _thread_columns(connection)
            if "id" not in columns:
                raise sqlite3.DatabaseError("Codex thread index is incomplete")

            text_columns = [
                column
                for column in ("name", "first_user_message", "title")
                if column in columns
            ]
            if not text_columns:
                raise sqlite3.DatabaseError("Codex thread text is unavailable")

            if "recency_at_ms" in columns:
                time_column = "recency_at_ms"
            elif "recency_at" in columns:
                time_column = "recency_at"
            elif "updated_at_ms" in columns:
                time_column = "updated_at_ms"
            elif "updated_at" in columns:
                time_column = "updated_at"
            else:
                raise sqlite3.DatabaseError("Codex thread recency is unavailable")

            conditions = [
                "("
                + " OR ".join(
                    f"NULLIF(TRIM({column}), '') IS NOT NULL"
                    for column in text_columns
                )
                + ")"
            ]
            if "archived" in columns:
                conditions.append("archived = 0")
            if "thread_source" in columns:
                conditions.append(
                    "(thread_source IS NULL "
                    "OR TRIM(thread_source) = '' "
                    "OR thread_source = 'user')"
                )
            if "agent_path" in columns:
                conditions.append(
                    "(agent_path IS NULL OR TRIM(agent_path) = '')"
                )
            name_expression = "name" if "name" in columns else "NULL"
            first_expression = (
                "first_user_message"
                if "first_user_message" in columns
                else "NULL"
            )
            title_expression = "title" if "title" in columns else "NULL"
            rollout_expression = (
                "rollout_path"
                if "rollout_path" in columns
                else "NULL"
            )
            rows = connection.execute(
                f"""
                SELECT id, {name_expression}, {first_expression},
                       {title_expression}, {time_column},
                       {rollout_expression}
                FROM threads
                WHERE {" AND ".join(conditions)}
                ORDER BY {time_column} DESC, id DESC
                LIMIT 30
                """
            ).fetchall()

        tasks: list[dict[str, Any]] = []
        for (
            thread_id,
            name,
            first_message,
            title_value,
            updated_at,
            rollout_value,
        ) in rows:
            name_reference = _task_reference(name)
            metadata_parts = [
                reference
                for source in (name, first_message, title_value)
                if (reference := _task_reference(source))
            ]
            if not metadata_parts:
                continue

            title = _english_explicit_name(name_reference)
            initial_reference = (
                name_reference
                or _task_reference(first_message)
                or _task_reference(title_value)
            )
            if not title:
                title = self._conversation_overviews.resolve(
                    thread_id,
                    rollout_value,
                    initial_reference,
                )
            if not title:
                title = _english_task_overview(
                    "",
                    initial_reference,
                    metadata_parts,
                )
            title = _ascii_bounded_phrase(title) or "Handle requested task"
            tasks.append({
                "title": title,
                "status": "recent",
                "updated_at": _iso_timestamp(updated_at),
            })
            if len(tasks) >= RECENT_TASK_LIMIT:
                break
        return tasks


def _recent_tasks() -> tuple[list[dict[str, Any]], dict[str, int]]:
    tasks = RecentTaskReader(_codex_home()).read()
    return tasks, {"recent": len(tasks)} if tasks else {}


def _safe_call(function, fallback, warnings: list[str]):
    try:
        return function()
    except Exception as error:  # Keep the panel useful if one local source fails.
        warnings.append(f"{function.__name__}: {type(error).__name__}")
        return fallback


def main() -> int:
    warnings: list[str] = []
    quota = _safe_call(_quota_state, None, warnings)
    quota = quota if isinstance(quota, dict) else {
        "limits": [],
        "_source": "error",
        "_stale": True,
    }
    quota_state = quota_availability(quota)

    unavailable_usage = {
        "today": None,
        **_today_estimate_payload(),
        "seven_days": 0,
        "ninety_days": 0,
        "days": [],
        "calendar_months": [],
        "source": "unavailable",
        "latest_bucket_date": None,
        "current_day_available": False,
        "includes_cached_input": False,
    }
    usage = _safe_call(_token_usage, unavailable_usage, warnings)
    usage_state = (
        Availability.UNAVAILABLE
        if usage is unavailable_usage or usage.get("source") == "unavailable"
        else Availability.READY
    )

    unavailable_tasks = ([], {})
    task_result = _safe_call(_recent_tasks, unavailable_tasks, warnings)
    tasks, activity_counts = task_result
    tasks_state = (
        Availability.UNAVAILABLE
        if task_result is unavailable_tasks
        else Availability.READY
    )
    payload = {
        "generated_at": dt.datetime.now().astimezone().isoformat(),
        "quota": quota,
        "usage": usage,
        "tasks": tasks,
        "activity_counts": activity_counts,
        "availability": availability_payload(
            quota=quota_state,
            usage=usage_state,
            tasks=tasks_state,
        ),
        "warnings": warnings,
    }
    json.dump(payload, sys.stdout, ensure_ascii=False, separators=(",", ":"))
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
