    re.IGNORECASE,
)
SENTENCE_END = re.compile(r"(?:[。！？；]+|[.!?]+(?=\s|$))")
NATURAL_BREAKS = frozenset("，、,;；:：")
INJECTED_SUMMARY_PREFIXES = (
    "another language model started to solve this problem",
    "produced a summary of its thinking process",
)
CODEX_BIN = resolve_codex_bin()


class Availability(StrEnum):
    READY = "ready"
    STALE = "stale"
    UNAVAILABLE = "unavailable"


def normalize_availability(value: Any) -> Availability:
    try:
        return Availability(value)
    except (TypeError, ValueError):
        return Availability.UNAVAILABLE


def quota_availability(
    quota: dict[str, Any],
    explicit: Any = None,
    *,
    now_seconds: float | None = None,
) -> Availability:
    explicit_state: Availability | None = None
    if explicit is not None:
        explicit_state = normalize_availability(explicit)
        if explicit_state is Availability.UNAVAILABLE:
            return Availability.UNAVAILABLE

    limits = quota.get("limits")
    if not isinstance(limits, list) or not limits:
        return Availability.UNAVAILABLE
    if explicit_state is Availability.STALE or quota.get("_stale") is True:
        return Availability.STALE

    updated_at = quota.get("updated_at_seconds")
    if (
        not isinstance(updated_at, bool)
        and isinstance(updated_at, (int, float))
        and math.isfinite(float(updated_at))
    ):
        now = time.time() if now_seconds is None else float(now_seconds)
        if math.isfinite(now) and now - float(updated_at) >= (
            QUOTA_STALE_AFTER_SECONDS
        ):
            return Availability.STALE
    return Availability.READY


def availability_payload(
    *,
    quota: Any,
    usage: Any,
    tasks: Any,
) -> dict[str, str]:
    return {
        "quota": normalize_availability(quota).value,
        "usage": normalize_availability(usage).value,
        "tasks": normalize_availability(tasks).value,
    }



def _codex_home() -> Path:
    return Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))


def _runtime_dir() -> Path:
    return Path(
        os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    )


def _local_activity_state_path() -> Path:
    return _runtime_dir() / "codex-dashboard-today.json"


def _quota_state() -> dict[str, Any]:
    path = _runtime_dir() / "codex-quota.json"
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return {"limits": [], "_source": "missing", "_stale": True}
    return payload if isinstance(payload, dict) else {
        "limits": [],
        "_source": "invalid",
        "_stale": True,
    }


def _latest_state_db(codex_home: Path) -> Path | None:
    candidates: list[tuple[int, Path]] = []
    for path in codex_home.glob("state_*.sqlite"):
        try:
            candidates.append((path.stat().st_mtime_ns, path))
        except OSError:
            continue
    return max(candidates, default=(0, None))[1]


def _connect_read_only(path: Path) -> sqlite3.Connection:
    return sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=0.5)


def _thread_index_path(codex_home: Path) -> Path:
    state_db = _latest_state_db(codex_home)
    if state_db is None or not state_db.is_file():
        raise FileNotFoundError("Codex thread index is unavailable")
    return state_db


def _thread_columns(connection: sqlite3.Connection) -> set[str]:
    return {
        str(row[1])
        for row in connection.execute("PRAGMA table_info(threads)")
        if len(row) > 1
    }


def _nonnegative_token_count(value: Any) -> int | None:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    try:
        numeric = float(value)
    except OverflowError:
        return None
    if not math.isfinite(numeric) or value < 0:
        return None
    return int(value)


def _load_local_activity_state(
    path: Path,
    codex_home: Path,
) -> dict[str, Any]:
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return {}
    if (
        not isinstance(payload, dict)
        or payload.get("version") != LOCAL_ACTIVITY_STATE_VERSION
        or payload.get("codex_home") != str(codex_home.resolve())
    ):
        return {}
    return payload


def _write_local_activity_state(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary_path: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=path.parent,
            prefix=".codex-dashboard-today-",
            suffix=".tmp",
            delete=False,
        ) as temporary:
            temporary_path = Path(temporary.name)
            os.fchmod(temporary.fileno(), 0o600)
            json.dump(
                payload,
                temporary,
                ensure_ascii=False,
                separators=(",", ":"),
            )
            temporary.flush()
            os.fsync(temporary.fileno())
        os.replace(temporary_path, path)
        temporary_path = None
    finally:
        if temporary_path is not None:
            try:
                temporary_path.unlink()
            except FileNotFoundError:
                pass


def _current_day_activity_state(
    path: Path,
    codex_home: Path,
    now: dt.datetime,
) -> dict[str, Any]:
    state = _load_local_activity_state(path, codex_home)
    if state.get("date") != now.date().isoformat():
        return {}
    return state


def _monotonic_today_estimate(
    value: int,
    path: Path,
    codex_home: Path,
    now: dt.datetime,
) -> int:
    state = _current_day_activity_state(path, codex_home, now)
    if not state:
        raise ValueError("Today estimate state is unavailable")
    previous = _nonnegative_token_count(state.get("last_estimate"))
    monotonic_value = max(value, previous or 0)
    if previous is not None and monotonic_value == previous:
        return previous
    state["last_estimate"] = monotonic_value
    try:
        _write_local_activity_state(path, state)
    except OSError:
        if previous is not None:
            return previous
        raise
    return monotonic_value


def _persisted_today_floor(
    path: Path,
    codex_home: Path,
    now: dt.datetime,
) -> int | None:
    state = _current_day_activity_state(path, codex_home, now)
    return _nonnegative_token_count(state.get("last_estimate"))


def _recent_day_totals(
    value: Any,
    cutoff: dt.date,
    before: dt.date,
) -> dict[str, int]:
    if not isinstance(value, dict):
        return {}
    totals: dict[str, int] = {}
    for day_value, tokens_value in value.items():
        if not isinstance(day_value, str):
            continue
        try:
            day = dt.date.fromisoformat(day_value)
        except ValueError:
            continue
        tokens = _nonnegative_token_count(tokens_value)
        if cutoff <= day < before and tokens is not None:
            totals[day_value] = tokens
    return totals


class LocalThreadTokenActivity:
    """Maintain monotonic local-day totals from numeric thread counters."""

    def __init__(
        self,
        codex_home: Path,
        state_path: Path,
        now: dt.datetime | None = None,
    ) -> None:
        self._codex_home = codex_home
        self._state_path = state_path
        self._now = now

    def build(self) -> dict[str, int]:
        now = self._now or dt.datetime.now().astimezone()
        if now.tzinfo is None:
            now = now.astimezone()
        timezone = now.tzinfo
        if timezone is None:
            raise ValueError("Local timezone is unavailable")

        state_db = _thread_index_path(self._codex_home)
        with _connect_read_only(state_db) as connection:
            columns = _thread_columns(connection)
            if "tokens_used" not in columns:
                raise sqlite3.DatabaseError(
                    "Codex thread token counters are unavailable"
                )
            time_column = next(
                (
                    column
                    for column in ("created_at", "created_at_ms")
                    if column in columns
                ),
                None,
            )
            if time_column is None:
                raise sqlite3.DatabaseError(
                    "Codex thread start times are unavailable"
                )

            rows = connection.execute(
                f"""
                SELECT {time_column}, tokens_used
                FROM threads
                """
            ).fetchall()

        today = now.date()
        cutoff = today - dt.timedelta(days=LOCAL_ESTIMATE_LOOKBACK_DAYS)
        grouped_totals: defaultdict[str, int] = defaultdict(int)
        account_total = 0
        valid_counter_rows = 0
        account_snapshot_complete = bool(rows)
        day_grouping_complete = bool(rows)
        for created_at, tokens_used in rows:
            tokens = _nonnegative_token_count(tokens_used)
            if tokens is None:
                account_snapshot_complete = False
                day_grouping_complete = False
                continue
            valid_counter_rows += 1
            account_total += tokens
            if (
                isinstance(created_at, bool)
                or not isinstance(created_at, (int, float))
                or not math.isfinite(float(created_at))
            ):
                day_grouping_complete = False
                continue
            timestamp = float(created_at)
            if time_column.endswith("_ms"):
                timestamp /= 1_000
            try:
                day = dt.datetime.fromtimestamp(
                    timestamp,
                    tz=timezone,
                ).date()
            except (OverflowError, OSError, ValueError):
                day_grouping_complete = False
                continue
            if cutoff <= day <= today:
                grouped_totals[day.isoformat()] += tokens
        if valid_counter_rows == 0:
            account_snapshot_complete = False
            day_grouping_complete = False

        offset = now.utcoffset()
        offset_seconds = int(offset.total_seconds()) if offset is not None else 0
        state = _load_local_activity_state(
            self._state_path,
            self._codex_home,
        )
        previous_total = _nonnegative_token_count(
            state.get("total_snapshot")
        )
        previous_today = _nonnegative_token_count(
            state.get("today_tokens")
        )
        try:
            previous_date = dt.date.fromisoformat(state.get("date", ""))
        except (TypeError, ValueError):
            previous_date = None

        baseline_is_trusted = (
            previous_date in {today, today - dt.timedelta(days=1)}
            and state.get("total_snapshot_complete") is True
            and previous_total is not None
        )
        today_snapshot_is_trusted = (
            baseline_is_trusted and previous_today is not None
        )
        if not account_snapshot_complete and not baseline_is_trusted:
            raise ValueError("No complete local token snapshot is available")

        completed_days = _recent_day_totals(
            state.get("completed_days") if baseline_is_trusted else None,
            cutoff,
            today,
        )
        if baseline_is_trusted and previous_date == today:
            if not account_snapshot_complete:
                if previous_today is None:
                    raise ValueError("Today local token activity is unavailable")
                totals = dict(completed_days)
                totals[today.isoformat()] = previous_today
                return totals

            if previous_today is not None:
                growth_estimate = previous_today + max(
                    0,
                    account_total - previous_total,
                )
                today_tokens = max(
                    growth_estimate,
                    grouped_totals.get(today.isoformat(), 0)
                    if day_grouping_complete
                    else 0,
                )
                total_snapshot = account_total
            elif day_grouping_complete:
                completed_days = {
                    day: tokens
                    for day, tokens in grouped_totals.items()
                    if day != today.isoformat()
                }
                today_tokens = max(
                    grouped_totals.get(today.isoformat(), 0),
                    max(0, account_total - previous_total),
                )
                total_snapshot = account_total
            else:
                growth = max(0, account_total - previous_total)
                today_tokens = growth if growth > 0 else None
                total_snapshot = account_total
        elif (
            today_snapshot_is_trusted
            and previous_date == today - dt.timedelta(days=1)
        ):
            if not account_snapshot_complete:
                raise ValueError("Today local token activity is unavailable")
            completed_days[previous_date.isoformat()] = previous_today
            today_tokens = max(
                grouped_totals.get(today.isoformat(), 0)
                if day_grouping_complete
                else 0,
                max(0, account_total - previous_total),
            )
            total_snapshot = account_total
        else:
            if day_grouping_complete:
                completed_days = {
                    day: tokens
                    for day, tokens in grouped_totals.items()
                    if day != today.isoformat()
                }
                today_tokens = grouped_totals.get(today.isoformat(), 0)
            else:
                completed_days = {}
                today_tokens = None
            total_snapshot = account_total

        payload = {
            "version": LOCAL_ACTIVITY_STATE_VERSION,
            "codex_home": str(self._codex_home.resolve()),
            "timezone_offset_seconds": offset_seconds,
            "date": today.isoformat(),
            "generated_at": now.isoformat(),
            "total_snapshot": total_snapshot,
            "total_snapshot_complete": True,
            "today_tokens": today_tokens,
            "completed_days": completed_days,
        }
        if previous_date == today and today_tokens is not None:
            last_estimate = _nonnegative_token_count(
                state.get("last_estimate")
            )
            if last_estimate is not None:
                payload["last_estimate"] = last_estimate
        _write_local_activity_state(self._state_path, payload)
        if today_tokens is None:
            raise ValueError("Today local token activity is unavailable")

        totals = dict(completed_days)
        totals[today.isoformat()] = today_tokens
        return totals


def _shift_month(value: dt.date, offset: int) -> dt.date:
    month_index = value.year * 12 + value.month - 1 + offset
    year, month = divmod(month_index, 12)
    return dt.date(year, month + 1, 1)


def _calendar_months(
    totals: dict[str, int],
    today: dt.date,
) -> list[dict[str, Any]]:
    months: list[dict[str, Any]] = []
    first_month = _shift_month(today, -(CALENDAR_MONTH_COUNT - 1))
    for offset in range(CALENDAR_MONTH_COUNT):
        month_start = _shift_month(first_month, offset)
        days_in_month = calendar.monthrange(
            month_start.year,
            month_start.month,
        )[1]
        last_day = today.day if (
            month_start.year == today.year
            and month_start.month == today.month
        ) else days_in_month

        def tokens_for_day(day: int) -> int | None:
            date = dt.date(month_start.year, month_start.month, day)
            key = date.isoformat()
            if key in totals:
                return totals[key]
            return None if date == today else 0

        months.append({
            "key": month_start.strftime("%Y-%m"),
            "label": calendar.month_name[month_start.month],
            "year": month_start.year,
            "month": month_start.month,
            "days": [
                {
                    "day": day,
                    "tokens": tokens_for_day(day),
                }
                for day in range(1, last_day + 1)
            ],
        })
    return months


def _today_estimate_payload(
    value: int | None = None,
    source: str | None = None,
    calibration_date: str | None = None,
) -> dict[str, Any]:
    return {
        "today_estimate": value,
        "today_is_estimate": value is not None,
        "today_estimate_source": source,
        "today_estimate_calibration_date": calibration_date,
    }


def _token_usage() -> dict[str, Any]:
    now = dt.datetime.now().astimezone()
    payload = _read_official_usage()
    usage = OfficialTokenActivity(now).build(payload)
    usage.update(_today_estimate_payload())
    local_activity = LocalThreadTokenActivity(
        _codex_home(),
        _local_activity_state_path(),
        now,
    )
    try:
        local_totals = local_activity.build()
    except (OSError, sqlite3.Error, ValueError, OverflowError):
        # Estimation is optional; never hide known official history if local
        # counters or their read-only index are temporarily unavailable.
        if not usage["current_day_available"]:
            floor = _persisted_today_floor(
                _local_activity_state_path(),
                _codex_home(),
                now,
            )
            if floor is not None:
                usage.update(_today_estimate_payload(
                    floor,
                    "local_thread_tokens_persisted_floor",
                ))
        return usage
    if usage["current_day_available"]:
        return usage

    estimate = _calibrated_today_estimate(
        local_totals,
        usage["days"],
        now.date(),
    )
    if estimate is None:
        return usage
    value, source, calibration_date = estimate
    try:
        value = _monotonic_today_estimate(
            value,
            _local_activity_state_path(),
            _codex_home(),
            now,
        )
    except (OSError, ValueError):
        return usage
    usage.update(_today_estimate_payload(value, source, calibration_date))
    return usage


def _read_official_usage(
    timeout_seconds: float = OFFICIAL_USAGE_TIMEOUT_SECONDS,
    *,
    query=query_codex_app_server,
) -> dict[str, Any]:
    return query(
        CODEX_BIN,
        "account/usage/read",
        None,
        timeout_seconds=timeout_seconds,
        max_line_bytes=MAX_PROTOCOL_LINE_BYTES,
        cancel_event=None,
    )


class OfficialTokenActivity:
    """Render account token activity returned by the Codex service."""

    def __init__(self, now: dt.datetime | None = None) -> None:
        self._now = now

    def build(self, payload: dict[str, Any]) -> dict[str, Any]:
        summary = payload.get("summary")
        buckets = payload.get("dailyUsageBuckets")
        if not isinstance(summary, dict) or not isinstance(buckets, list):
            raise ValueError("Official token activity is unavailable")

        now = self._now or dt.datetime.now().astimezone()
        if now.tzinfo is None:
            now = now.astimezone()
        today = now.date()
        totals: defaultdict[str, int] = defaultdict(int)
        for bucket in buckets:
            if not isinstance(bucket, dict):
                continue
            day = bucket.get("startDate")
            tokens = bucket.get("tokens")
            if (
                not isinstance(day, str)
                or isinstance(tokens, bool)
                or not isinstance(tokens, (int, float))
                or not math.isfinite(float(tokens))
                or tokens < 0
            ):
                continue
            try:
                parsed_day = dt.date.fromisoformat(day)
            except ValueError:
                continue
            if parsed_day <= today:
                totals[parsed_day.isoformat()] += int(tokens)

        current_day_available = today.isoformat() in totals
        daily = []
        for offset in range(HISTORY_DAYS - 1, -1, -1):
            day = today - dt.timedelta(days=offset)
            key = day.isoformat()
            daily.append({
                "date": key,
                "tokens": (
                    totals[key]
                    if key in totals
                    else None
                    if day == today
                    else 0
                ),
            })
        latest_bucket_date = max(totals, default=None)

        def known_total(items: list[dict[str, Any]]) -> int:
            return sum(
                item["tokens"]
                for item in items
                if isinstance(item.get("tokens"), int)
            )

        def summary_tokens(key: str) -> int | None:
            value = summary.get(key)
            if (
                isinstance(value, bool)
                or not isinstance(value, (int, float))
                or not math.isfinite(float(value))
                or value < 0
            ):
                return None
            return int(value)

        return {
            "today": daily[-1]["tokens"],
            "seven_days": known_total(daily[-7:]),
            "ninety_days": known_total(daily[-90:]),
            "lifetime": summary_tokens("lifetimeTokens"),
            "peak_daily": summary_tokens("peakDailyTokens"),
            "latest_bucket_date": latest_bucket_date,
            "current_day_available": current_day_available,
            "days": daily,
            "calendar_months": _calendar_months(totals, today),
            "source": "official_account_usage",
            "includes_cached_input": False,
        }


def _valid_calibration_factor(value: float) -> bool:
    return (
        math.isfinite(value)
        and MIN_CALIBRATION_FACTOR <= value <= MAX_CALIBRATION_FACTOR
    )


def _calibrated_today_estimate(
    local_totals: dict[str, int],
    official_days: list[dict[str, Any]],
    today: dt.date,
) -> tuple[int, str, str | None] | None:
    if not isinstance(local_totals, dict):
        return None
    today_key = today.isoformat()
    local_today = _nonnegative_token_count(local_totals.get(today_key))
    if local_today is None:
        return None
    if local_today == 0:
        return 0, "local_thread_tokens", None

    cutoff = today - dt.timedelta(days=LOCAL_ESTIMATE_LOOKBACK_DAYS)
    samples: list[tuple[dt.date, int, int]] = []
    for item in official_days:
        if not isinstance(item, dict):
            continue
        day_value = item.get("date")
        official_tokens = _nonnegative_token_count(item.get("tokens"))
        if not isinstance(day_value, str) or not official_tokens:
            continue
        try:
            day = dt.date.fromisoformat(day_value)
        except ValueError:
            continue
        local_tokens = _nonnegative_token_count(local_totals.get(day_value))
        if (
            cutoff <= day < today
            and local_tokens is not None
            and local_tokens > 0
        ):
            samples.append((day, official_tokens, local_tokens))

    if samples:
        latest_day, official_tokens, local_tokens = max(samples)
        latest_factor = official_tokens / local_tokens
        if _valid_calibration_factor(latest_factor):
            return (
                int(math.floor(local_today * latest_factor + 0.5)),
                "local_thread_tokens_recent_calibration",
                latest_day.isoformat(),
            )

    return local_today, "local_thread_tokens_uncalibrated", None


def _display_width(value: str) -> int:
    return sum(
        0
        if unicodedata.combining(character)
        else 2
        if unicodedata.east_asian_width(character) in {"W", "F"}
        else 1
        for character in value
    )


def _bounded_text(value: Any, columns: int = TASK_OVERVIEW_COLUMNS) -> str:
    if not isinstance(value, str):
        return ""
    text = " ".join(value.split())
    if _display_width(text) <= columns:
        return text

    prefix: list[str] = []
    width = 0
    for character in text:
        character_width = _display_width(character)
        if width + character_width > columns - 1:
            break
        prefix.append(character)
        width += character_width

    candidate = "".join(prefix).rstrip()
    minimum_break_width = columns * 3 // 5
    break_at = max(
        (
            index + 1
            for index, character in enumerate(candidate)
            if (
                character in NATURAL_BREAKS or character.isspace()
            )
            and _display_width(candidate[:index + 1]) >= minimum_break_width
        ),
        default=0,
    )
    if break_at:
        candidate = candidate[:break_at].rstrip()
    return candidate + "…"


def _strip_task_command_prefix(value: Any) -> str:
    if not isinstance(value, str):
        return ""
    return TASK_COMMAND_PREFIX.sub("", value.lstrip())


def _strip_injected_prefixes(value: str) -> str:
    text = value.lstrip()
    if INJECTED_MARKDOWN_ONLY.match(text):
        return ""

    agents_header = AGENTS_HEADER.match(text)
    if agents_header:
        text = text[agents_header.end():]

    removed_block = False
    while match := INJECTED_XML_BLOCK.match(text):
        removed_block = True
        text = text[match.end():].lstrip()

    if (agents_header and not removed_block) or INJECTED_XML_OPEN.match(text):
        return ""
    if text.casefold().startswith(INJECTED_SUMMARY_PREFIXES):
        return ""
    return text


def _task_overview(value: Any) -> str:
    """Extract one bounded, source-language sentence from thread metadata."""

    if not isinstance(value, str):
        return ""
    text = unicodedata.normalize("NFC", value)
    text = _strip_task_command_prefix(text)
    text = _strip_injected_prefixes(text)
    text = IMAGE_PLACEHOLDER.sub(" ", text)
    text = LEADING_MARKDOWN.sub("", text)
    text = " ".join(text.split())
    text = LEADING_GREETING.sub("", text).strip()
    if not text:
        return ""

    sentence_end = SENTENCE_END.search(text)
    if sentence_end:
        text = text[:sentence_end.end()].rstrip()
    return _bounded_text(text)


def _iso_timestamp(value: Any) -> str:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return ""
    numeric = float(value)
    if not math.isfinite(numeric) or numeric <= 0:
        return ""
    if numeric >= 10_000_000_000:
        numeric /= 1_000
    try:
        moment = dt.datetime.fromtimestamp(numeric, tz=dt.timezone.utc)
    except (OverflowError, OSError, ValueError):
        return ""
    return moment.isoformat().replace("+00:00", "Z")


class RecentTaskReader:
    """Read one bounded overview per recent root thread from the state index."""

    def __init__(self, codex_home: Path) -> None:
        self._codex_home = codex_home

    def read(self) -> list[dict[str, Any]]:
        state_db = _thread_index_path(self._codex_home)
        with _connect_read_only(state_db) as connection:
            columns = _thread_columns(connection)
            if "id" not in columns:
                raise sqlite3.DatabaseError("Codex thread index is incomplete")

            text_columns = [
                column
                for column in ("name", "first_user_message", "title")
                if column in columns
            ]
            if not text_columns:
                raise sqlite3.DatabaseError("Codex thread text is unavailable")

            if "recency_at_ms" in columns:
                time_column = "recency_at_ms"
            elif "recency_at" in columns:
                time_column = "recency_at"
            elif "updated_at_ms" in columns:
                time_column = "updated_at_ms"
            elif "updated_at" in columns:
                time_column = "updated_at"
            else:
                raise sqlite3.DatabaseError("Codex thread recency is unavailable")

            conditions = [
                "("
                + " OR ".join(
                    f"NULLIF(TRIM({column}), '') IS NOT NULL"
                    for column in text_columns
                )
                + ")"
            ]
            if "archived" in columns:
                conditions.append("archived = 0")
            if "thread_source" in columns:
                conditions.append(
                    "(thread_source IS NULL "
                    "OR TRIM(thread_source) = '' "
                    "OR thread_source = 'user')"
                )
            if "agent_path" in columns:
                conditions.append(
                    "(agent_path IS NULL OR TRIM(agent_path) = '')"
                )
            name_expression = "name" if "name" in columns else "NULL"
            first_expression = (
                "first_user_message"
                if "first_user_message" in columns
                else "NULL"
            )
            title_expression = "title" if "title" in columns else "NULL"
            rows = connection.execute(
                f"""
                SELECT id, {name_expression}, {first_expression},
                       {title_expression}, {time_column}
                FROM threads
                WHERE {" AND ".join(conditions)}
                ORDER BY {time_column} DESC, id DESC
                LIMIT 30
                """
            ).fetchall()

        tasks: list[dict[str, Any]] = []
        for _thread_id, name, first_message, title_value, updated_at in rows:
            title = next(
                (
                    overview
                    for source in (name, first_message, title_value)
                    if (overview := _task_overview(source))
                ),
                "",
            )
            if not title:
                continue
            tasks.append({
                "title": title,
                "status": "recent",
                "updated_at": _iso_timestamp(updated_at),
            })
            if len(tasks) >= RECENT_TASK_LIMIT:
                break
        return tasks


def _recent_tasks() -> tuple[list[dict[str, Any]], dict[str, int]]:
    tasks = RecentTaskReader(_codex_home()).read()
    return tasks, {"recent": len(tasks)} if tasks else {}


def _safe_call(function, fallback, warnings: list[str]):
    try:
        return function()
    except Exception as error:  # Keep the panel useful if one local source fails.
        warnings.append(f"{function.__name__}: {type(error).__name__}")
        return fallback


def main() -> int:
    warnings: list[str] = []
    quota = _safe_call(_quota_state, None, warnings)
    quota = quota if isinstance(quota, dict) else {
        "limits": [],
        "_source": "error",
        "_stale": True,
    }
    quota_state = quota_availability(quota)

    unavailable_usage = {
        "today": None,
        **_today_estimate_payload(),
        "seven_days": 0,
        "ninety_days": 0,
        "days": [],
        "calendar_months": [],
        "source": "unavailable",
        "latest_bucket_date": None,
        "current_day_available": False,
        "includes_cached_input": False,
    }
    usage = _safe_call(_token_usage, unavailable_usage, warnings)
    usage_state = (
        Availability.UNAVAILABLE
        if usage is unavailable_usage or usage.get("source") == "unavailable"
        else Availability.READY
    )

    unavailable_tasks = ([], {})
    task_result = _safe_call(_recent_tasks, unavailable_tasks, warnings)
    tasks, activity_counts = task_result
    tasks_state = (
        Availability.UNAVAILABLE
        if task_result is unavailable_tasks
        else Availability.READY
    )
    payload = {
        "generated_at": dt.datetime.now().astimezone().isoformat(),
        "quota": quota,
        "usage": usage,
        "tasks": tasks,
        "activity_counts": activity_counts,
        "availability": availability_payload(
            quota=quota_state,
            usage=usage_state,
            tasks=tasks_state,
        ),
        "warnings": warnings,
    }
    json.dump(payload, sys.stdout, ensure_ascii=False, separators=(",", ":"))
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
