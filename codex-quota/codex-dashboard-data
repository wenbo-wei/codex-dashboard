HISTORY_DAYS = 91
CALENDAR_MONTH_COUNT = 3
RECENT_TASK_LIMIT = 5
TASK_OVERVIEW_COLUMNS = 96
OFFICIAL_USAGE_TIMEOUT_SECONDS = 8.0
MAX_PROTOCOL_LINE_BYTES = 4 * 1024 * 1024
LOCAL_ESTIMATE_LOOKBACK_DAYS = 7
LOCAL_ACTIVITY_STATE_VERSION = 2
MIN_CALIBRATION_FACTOR = 0.05
MAX_CALIBRATION_FACTOR = 20.0
QUOTA_STALE_AFTER_SECONDS = 300.0
IMAGE_PLACEHOLDER = re.compile(r"\[Image(?:\s+#?\d+)?\]", re.IGNORECASE)
TASK_COMMAND_PREFIX = re.compile(
    r"^(?:(?:[$/][A-Za-z][A-Za-z0-9_-]*):?(?:\s+|$))+",
)
AGENTS_HEADER = re.compile(
    r"^\s*#{1,6}\s*AGENTS\.md instructions[^\r\n]*(?:\r?\n|$)",
    re.IGNORECASE,
)
INJECTED_MARKDOWN_ONLY = re.compile(
    r"^\s*#{1,6}\s*(?:Skills|Handoff)(?:\s|:|$)",
    re.IGNORECASE,
)
INJECTED_XML_BLOCK = re.compile(
    r"^\s*(?:(?:>\s*)+)?"
    r"<(?P<tag>INSTRUCTIONS|environment_context|handoff|"
    r"skills_instructions|skill)\b[^>]*>"
    r".*?</(?P=tag)\s*>\s*",
    re.IGNORECASE | re.DOTALL,
)
